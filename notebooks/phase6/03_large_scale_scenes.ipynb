    "# 可扩展性曲线\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# 1. 内存占用\n",
    "ax = axes[0, 0]\n",
    "n_gaussians = np.array([50, 500, 5000]) * 1e3  # K\n",
    "memory_train = n_gaussians * 110 / 1e9  # GB\n",
    "memory_infer = n_gaussians * 30 / 1e9   # GB\n",
    "\n",
    "ax.loglog(n_gaussians/1e3, memory_infer, 'o-', linewidth=2, markersize=10, label='Inference')\n",
    "ax.loglog(n_gaussians/1e3, memory_train, 's-', linewidth=2, markersize=10, label='Training')\n",
    "ax.axhline(8, color='red', linestyle='--', linewidth=2, label='GPU 8GB limit')\n",
    "ax.axhline(24, color='orange', linestyle='--', linewidth=2, label='GPU 24GB limit')\n",
    "ax.set_xlabel('Number of Gaussians (K)', fontweight='bold')\n",
    "ax.set_ylabel('Memory (GB)', fontweight='bold')\n",
    "ax.set_title('Memory Requirement', fontsize=11, fontweight='bold')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# 2. 渲染帧率\n",
    "ax = axes[0, 1]\n",
    "n_gauss = np.array([50, 100, 500, 1000, 5000, 10000])  # K\n",
    "fps = 1000 / (n_gauss * 0.02 + 10)  # 模拟公式\n",
    "\n",
    "ax.loglog(n_gauss, fps, 'o-', linewidth=2, markersize=10, color='steelblue')\n",
    "ax.axhline(30, color='green', linestyle='--', linewidth=2, label='Real-time threshold')\n",
    "ax.axhline(1, color='red', linestyle='--', linewidth=2, label='Painful threshold')\n",
    "ax.set_xlabel('Number of Gaussians (K)', fontweight='bold')\n",
    "ax.set_ylabel('Frames Per Second (FPS)', fontweight='bold')\n",
    "ax.set_title('Rendering Performance', fontsize=11, fontweight='bold')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# 3. 优化时间\n",
    "ax = axes[1, 0]\n",
    "n_frames = np.array([100, 500, 1000, 5000])  # 图像数\n",
    "opt_time_small = n_frames * 2 / 60  # 小场景：2s/100张\n",
    "opt_time_large = n_frames * 50 / 60  # 大场景：50s/100张\n",
    "\n",
    "ax.plot(n_frames, opt_time_small, 'o-', linewidth=2, markersize=10, label='Small scene (50K)')\n",
    "ax.plot(n_frames, opt_time_large, 's-', linewidth=2, markersize=10, label='Large scene (5M)')\n",
    "ax.set_xlabel('Number of Training Images', fontweight='bold')\n",
    "ax.set_ylabel('Total Optimization Time (hours)', fontweight='bold')\n",
    "ax.set_title('Training Time', fontsize=11, fontweight='bold')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# 4. 应用覆盖范围\n",
    "ax = axes[1, 1]\n",
    "ax.set_xlim(0, 10)\n",
    "ax.set_ylim(0, 10)\n",
    "ax.axis('off')\n",
    "\n",
    "scenes = [\n",
    "    (1, 8, 'Room/Object', '#FF6B6B', '✓ 成熟'),\n",
    "    (3, 6, 'Indoor Scene', '#4ECDC4', '✓ 成熟'),\n",
    "    (5, 4, 'Building/Campus', '#FFA07A', '○ 困难'),\n",
    "    (7, 2, 'City-scale', '#FFD93D', '✗ 限制'),\n",
    "]\n",
    "\n",
    "for x, y, label, color, status in scenes:\n",
    "    rect = Rectangle((x-0.8, y-0.4), 1.6, 0.8, \n",
