    "    ax.add_patch(rect)\n",
    "    ax.text(x, y, label, ha='center', va='center', fontsize=9, fontweight='bold')\n",
    "    ax.text(x+1.3, y, status, ha='left', va='center', fontsize=8)\n",
    "\n",
    "ax.arrow(0.5, 9, 8.5, 0, head_width=0.2, head_length=0.3, fc='gray', ec='gray')\nax.text(4.5, 9.5, 'Scene Scale →', ha='center', fontsize=10, fontweight='bold')\n\nax.set_title('Application Scope', fontsize=11, fontweight='bold', loc='left', pad=10)\n\nplt.tight_layout()\nplt.show()\n\nprint(\"\\n可扩展性瓶颈总结：\")\nprint(\"1. 内存：GPU 显存有限（8-80GB），大场景需要 50GB+\")\nprint(\"2. 速度：光栅化复杂度 O(N)，100 万高斯时丧失实时性\")\nprint(\"3. 一致性：分块优化导致接缝、伪影\")\nprint(\"4. 优化：大数据集上训练时间过长（数天）\")"
