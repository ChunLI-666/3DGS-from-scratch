    "# 城市级重建示意\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 12))\n",
    "\n",
    "# 1. 城市分块\n",
    "ax = axes[0, 0]\n",
    "np.random.seed(42)\n",
    "# 网格分块\n",
    "n_blocks = 8\n",
    "for i in range(n_blocks):\n",
    "    for j in range(n_blocks):\n",
    "        x, y = i, j\n",
    "        # 随机图像数\n",
    "        img_count = np.random.randint(50, 200)\n",
    "        color_intensity = img_count / 200\n",
    "        rect = Rectangle((x, y), 1, 1, facecolor=plt.cm.YlOrRd(color_intensity),\n",
    "                        edgecolor='black', linewidth=1)\n",
    "        ax.add_patch(rect)\n",
    "\nax.set_xlim(-0.5, n_blocks - 0.5)\nax.set_ylim(-0.5, n_blocks - 0.5)\nax.set_aspect('equal')\nax.set_xlabel('Longitude')\nax.set_ylabel('Latitude')\nax.set_title('City Blocks (色度 = 图像数)', fontsize=11, fontweight='bold')\nax.invert_yaxis()\n\n# 2. 块内高斯分布\nax = axes[0, 1]\n# 一个块内的高斯密度分布\nx = np.linspace(-100, 100, 50)\ny = np.linspace(-100, 100, 50)\nX, Y = np.meshgrid(x, y)\nZ = np.exp(-((X-0)**2 + (Y-0)**2) / 1000) + np.random.randn(50, 50) * 0.1\nZ = np.maximum(Z, 0)\n\nim = ax.imshow(Z, extent=[-100, 100, -100, 100], cmap='viridis', origin='lower')\nax.set_xlabel('X (meters)')\nax.set_ylabel('Y (meters)')\nax.set_title('Gaussian Density in a Block', fontsize=11, fontweight='bold')\nplt.colorbar(im, ax=ax, label='Gaussian Count')\n\n# 3. LOD 层级\nax = axes[1, 0]\nlevels = ['Level 0\\n(远景)', 'Level 1\\n(中景)', 'Level 2\\n(近景)']\ngaussian_counts = [500, 5000, 50000]\ncolors_lod = ['#FFD93D', '#45B7D1', '#FF6B6B']\n\nbars = ax.barh(levels, gaussian_counts, color=colors_lod, alpha=0.7, edgecolor='black', linewidth=2)\nfor i, (bar, val) in enumerate(zip(bars, gaussian_counts)):\n    ax.text(val + 1000, i, f'{val/1000:.0f}K', va='center', fontsize=10, fontweight='bold')\n\nax.set_xscale('log')\nax.set_xlabel('Number of Gaussians', fontweight='bold')\nax.set_title('Multi-Resolution Levels', fontsize=11, fontweight='bold')\nax.grid(True, alpha=0.3, axis='x')\n\n# 4. 内存和速度权衡\nax = axes[1, 1]\nlod_levels = np.array([0, 1, 2])\nmemory_usage = np.array([100, 1000, 10000])  # MB\nrendering_fps = np.array([200, 60, 15])\n\nax2 = ax.twinx()\n\nline1 = ax.plot(lod_levels, memory_usage, 'o-', linewidth=2.5, markersize=10,\n               color='steelblue', label='Memory Usage')\nax.set_xlabel('LOD Level', fontweight='bold')\nax.set_ylabel('Memory (MB)', fontweight='bold', color='steelblue')\nax.tick_params(axis='y', labelcolor='steelblue')\nax.set_xticks([0, 1, 2])\nax.set_xticklabels(['Level 0', 'Level 1', 'Level 2'])\n\nline2 = ax2.plot(lod_levels, rendering_fps, 's-', linewidth=2.5, markersize=10,\n                color='coral', label='Rendering FPS')\nax2.set_ylabel('Frames Per Second', fontweight='bold', color='coral')\nax2.tick_params(axis='y', labelcolor='coral')\n\nax.set_title('LOD Trade-off: Memory vs Speed', fontsize=11, fontweight='bold')\nax.grid(True, alpha=0.3)\n\n# 合并图例\nlines = line1 + line2\nlabels = [l.get_label() for l in lines]\nax.legend(lines, labels, loc='upper left')\n\nplt.tight_layout()\nplt.show()\n\nprint(\"\\n城市级重建的关键策略：\")\nprint(\"1. 分块：100-200m 块，每块独立处理\")\nprint(\"2. 层次化：远景粗、近景精，根据距离动态切换\")\nprint(\"3. 流式加载：只保留视野内的块在内存\")\nprint(\"4. 全局约束：块间对齐使用 GPS + 特征匹配\")\nprint(\"5. 并行化：多块可在多 GPU 上并行优化\")"
   ]
